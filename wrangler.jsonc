{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "refugee-work-rights",
  "compatibility_date": "2026-08-01",
  // Pure static-assets Worker — no script. Wrangler uploads dist/ and serves it.
  "assets": {
    "directory": "./dist",
    // Matches Astro's directory-format output: /about → 308 → /about/ → about/index.html
    "html_handling": "auto-trailing-slash",
    // Serve Astro's dist/404.html for unknown routes
    "not_found_handling": "404-page"
  }
}
