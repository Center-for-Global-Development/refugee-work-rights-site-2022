---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ScorecardShell from '../../components/ScorecardShell.astro';

const { data: page } = (await getEntry('pages', 'scorecard'))!;
---

<Base
  title={page.title}
  bodyClass={page.bodyClass}
  path={page.path}
  blockSupportsCss={page.blockSupportsCss}
>
  <ScorecardShell />
</Base>
