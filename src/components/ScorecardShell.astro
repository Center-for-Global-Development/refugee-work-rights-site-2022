---
// The scorecard page body shared by /scorecard/ and /scorecard/[slug]/:
// scorecard-header (h1 + nav island) + the page's static intro content
// (the body of src/content/pages/scorecard.md) + the SPA island where
// <router-view> used to be.
import { getEntry } from 'astro:content';
import ScorecardNav from '../scorecard/ScorecardNav';
import ScorecardApp from '../scorecard/ScorecardApp';

const page = await getEntry('pages', 'scorecard');
---

<div class="scorecard-header">
  <h1>The Global Refugee Work Rights Scorecard</h1>
  <ScorecardNav client:only="react" />
</div>
<Fragment set:html={page!.body} />
<ScorecardApp client:only="react" />
